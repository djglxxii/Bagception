<?xml version="1.0" encoding="utf-8"?>
<!--
  Probe templates for Phase 1. Two containers only: the Bagception master bag and
  one internal sub-bag. Both inherit CONT_Bag_A (3e6aac21-333b-4812-a554-376c2d157ba9,
  Gustav.pak), the generic bag container: InventoryType 11, working container
  behaviour, icon, visual, physics and bounds. No custom art, per the Phase 2 art
  decision in docs/tracking/decision-log.md.

  The sub-bag carries ContainerContentFilterCondition, BG3's native auto-collect
  filter. Whether it fires while nested inside the master bag is the question this
  build exists to answer; see docs/tracking/open-questions.md.

  Both use mod-owned Stats entries with Weight 0 so the containers themselves cost
  nothing to carry.

  Icon, visual, physics and bounds are deliberately not set: they inherit from
  CONT_Bag_A. Custom art for every container is a Phase 8 commitment.
-->
<save>
	<version major="4" minor="0" revision="9" build="331" />
	<region id="Templates">
		<node id="Templates">
			<children>
				<node id="GameObjects">
					<attribute id="Description" type="TranslatedString" handle="h271db971g9d0dgea47g01a5gd3c2ade18566" version="1" />
					<attribute id="DisplayName" type="TranslatedString" handle="ha86b2ccag9495g083fgad32g4bc47d3bc676" version="1" />
					<attribute id="LevelName" type="FixedString" value="" />
					<attribute id="MapKey" type="FixedString" value="856bd140-6963-4de1-9471-25440149e87d" />
					<attribute id="Name" type="LSString" value="BAGCEPTION_CONT_Master" />
					<attribute id="ParentTemplateId" type="FixedString" value="3e6aac21-333b-4812-a554-376c2d157ba9" />
					<attribute id="Stats" type="FixedString" value="OBJ_Bagception_Master" />
					<attribute id="Type" type="FixedString" value="item" />
					<children>
						<node id="InventoryList" />
						<node id="Tags">
							<children>
								<node id="Tag">
									<attribute id="Object" type="guid" value="e9e54868-4241-49d7-b7ac-9202a8cd6397" />
								</node>
							</children>
						</node>
					</children>
				</node>
				<node id="GameObjects">
					<attribute id="ContainerAutoAddOnPickup" type="bool" value="True" />
					<attribute id="ContainerContentFilterCondition" type="LSString" value="Tagged('ALCH_SOLUTION_POTION')" />
					<attribute id="Description" type="TranslatedString" handle="h2bc86cc7g38afg9ffbg9fbdgedd510514cd8" version="1" />
					<attribute id="DisplayName" type="TranslatedString" handle="h99b68a19g753cg6b16g30e4g2da2c0daac42" version="1" />
					<attribute id="LevelName" type="FixedString" value="" />
					<attribute id="MapKey" type="FixedString" value="8bf1ed2d-3655-415e-868e-fe3138760337" />
					<attribute id="Name" type="LSString" value="BAGCEPTION_CONT_PotionCase" />
					<attribute id="ParentTemplateId" type="FixedString" value="3e6aac21-333b-4812-a554-376c2d157ba9" />
					<attribute id="Stats" type="FixedString" value="OBJ_Bagception_PotionCase" />
					<attribute id="Type" type="FixedString" value="item" />
					<children>
						<node id="InventoryList" />
						<node id="Tags">
							<children>
								<node id="Tag">
									<attribute id="Object" type="guid" value="a97f9268-5575-4f3d-8bca-58b31986b308" />
								</node>
							</children>
						</node>
					</children>
				</node>
			</children>
		</node>
	</region>
</save>
