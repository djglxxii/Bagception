# Local machine paths and editor state
dirs.txt
.vscode/
.idea/
*.swp

# BG3 build/package outputs
dist/
*.pak
*.zip
*.7z

# Local third-party tooling
tools/external/

# Logs and temporary files
*.log
logs/
tmp/
temp/
crimelog.*.txt
dialoglog.*.txt
errors.*.txt
log.*.txt
personallog.*.txt
thothlog.*.txt
imgui.ini

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Toolkit story build artifacts, regenerated by the Story Editor on every build.
# Only the hand-authored goals under Story/RawFiles/Goals/ are source.
src/Mods/*/Story/goals.raw
src/Mods/*/Story/story.div
src/Mods/*/Story/story.div.osi
src/Mods/*/Story/story_ac.dat
src/Mods/*/Story/story_orphanqueries_*.txt
src/Mods/*/Story/log.txt
src/Mods/*/Story/RawFiles/story_header.div
src/Mods/*/Story/RawFiles/story_definitions.div

# Resources compiled from the authored .lsx, regenerated by tools/Package-Mod.ps1
# and by the Toolkit. The .lsx is the source.
src/Public/*/**/*.lsf
